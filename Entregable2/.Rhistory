cat("\n" %>% rep(2) %>% paste0(collapse = ""))
cat("\n -- INTERPRETACIÓN: Efecto de Distancia y Azimut en AP --\n")
# Análisis de tendencias por distancia
cat("1. EFECTO DE LA DISTANCIA:\n")
cat("-" %>% rep(70) %>% paste0(collapse = ""), "\n")
# Calcular mAP promedio por bin de distancia
map_by_range <- ap_by_range %>%
group_by(range_bin) %>%
summarise(mean_ap = mean(ap, na.rm = TRUE), .groups = "drop") %>%
arrange(range_bin)
print(map_by_range)
if(nrow(map_by_range) >= 2) {
trend_range <- map_by_range$mean_ap[1] > map_by_range$mean_ap[nrow(map_by_range)]
cat("\n   • Tendencia general:",
ifelse(trend_range, "DECRECIENTE", "NO CLARA"), "\n")
if(trend_range) {
cat("   • SÍ, el AP mejora en distancias más cercanas\n")
cat("   • Explicación física: Mayor SNR, menor incertidumbre de medición\n")
} else {
cat("   • La tendencia no es clara o no sigue el patrón esperado\n")
cat("   • Posibles causas: Efectos de muestreo, características de los datos\n")
}
}
cat("\n\n2. EFECTO DEL AZIMUT:\n")
cat("-" %>% rep(70) %>% paste0(collapse = ""), "\n")
# Calcular mAP promedio por bin de azimut
map_by_azimuth <- ap_by_azimuth %>%
group_by(azimuth_bin) %>%
summarise(mean_ap = mean(ap, na.rm = TRUE), .groups = "drop") %>%
arrange(azimuth_bin)
print(map_by_azimuth)
if(nrow(map_by_azimuth) >= 2) {
trend_azimuth <- map_by_azimuth$mean_ap[1] > map_by_azimuth$mean_ap[nrow(map_by_azimuth)]
cat("\n   • Tendencia general:",
ifelse(trend_azimuth, "DECRECIENTE", "NO CLARA"), "\n")
if(trend_azimuth) {
cat("   • SÍ, el AP mejora con ángulos más cercanos a 0\n")
cat("   • Explicación física: Mayor ganancia de antena, mejor resolución angular\n")
} else {
cat("   • La tendencia no es clara o no sigue el patrón esperado\n")
cat("   • Posibles causas: Características específicas del radar, efectos de muestreo\n")
}
}
cat("\n\n3. RECOMENDACIONES OPERACIONALES:\n")
cat("-" %>% rep(70) %>% paste0(collapse = ""), "\n")
cat("   • Priorizar detecciones en rangos cercanos (< 60m) para mayor confiabilidad\n")
cat("   • Ser más conservador con detecciones en ángulos periféricos (|azimut| > 0.4)\n")
cat("   • Considerar umbrales de confianza adaptativos según distancia y azimut\n")
cat("Análisis: Persona (7) vs Resto\n")
cat("Objetivo: Seleccionar umbral priorizando PRECISIÓN\n\n")
# Crear etiquetas binarias
y_train_binary <- as.numeric(y_train_numeric == 7)
y_val_binary <- as.numeric(y_validation_numeric == 7)
# Obtener probabilidades para clase Persona (índice 8 en matriz 12x1, clase 7)
y_score_train <- y_pred_train_proba[, 8]  # Clase 7 → índice 8
y_score_val <- y_pred_val_proba[, 8]
cat("Distribución binaria:\n")
cat("Train - Persona:", sum(y_train_binary == 1),
"| Resto:", sum(y_train_binary == 0), "\n")
cat("Validation - Persona:", sum(y_val_binary == 1),
"| Resto:", sum(y_val_binary == 0), "\n")
# Calcular curva PR
pr_train <- pr.curve(
scores.class0 = y_score_train[y_train_binary == 1],
scores.class1 = y_score_train[y_train_binary == 0],
curve = TRUE
)
cat("\nAP para Persona vs Resto (Training):", round(pr_train$auc.integral, 4), "\n")
# Extraer datos de la curva
# PRROC devuelve: [Recall, Precision, Threshold]
pr_data <- data.frame(
recall = pr_train$curve[, 1],
precision = pr_train$curve[, 2],
threshold = pr_train$curve[, 3]
)
# Filtrar datos válidos
pr_data <- pr_data[!is.na(pr_data$precision) & !is.na(pr_data$recall), ]
pr_data <- pr_data[is.finite(pr_data$precision) & is.finite(pr_data$recall), ]
# Plot curva PR
ggplot(pr_data, aes(x = recall, y = precision)) +
geom_line(color = "#377EB8", linewidth = 1.5) +
geom_abline(slope = -1, intercept = 1, linetype = "dashed",
color = "gray", alpha = 0.5) +
labs(title = "Curva Precision-Recall: Persona vs Resto (Training)",
subtitle = paste0("AP = ", round(pr_train$auc.integral, 4)),
x = "Recall (Sensibilidad)",
y = "Precision (Valor Predictivo Positivo)") +
coord_cartesian(xlim = c(0, 1), ylim = c(0, 1)) +
theme_minimal() +
theme(plot.title = element_text(face = "bold"))
cat("\nSELECCIÓN DE UMBRAL\n")
cat("Estrategia: Priorizar precisión (objetivo: ≥ 90%)\n")
# Estrategia 1: Precisión mínima objetivo
target_precision <- 0.90
# Encontrar umbral que logre precision >= target, maximizando recall
candidates <- pr_data %>%
filter(precision >= target_precision) %>%
arrange(desc(recall))
if(nrow(candidates) > 0) {
selected_threshold <- candidates$threshold[1]
selected_precision <- candidates$precision[1]
selected_recall <- candidates$recall[1]
cat("Umbral encontrado:\n")
cat("   • Threshold:", round(selected_threshold, 4), "\n")
cat("   • Precision (Train):", round(selected_precision, 4), "\n")
cat("   • Recall (Train):", round(selected_recall, 4), "\n")
cat("   • F1 (Train):",
round(2 * selected_precision * selected_recall /
(selected_precision + selected_recall), 4), "\n")
} else {
# Si no se alcanza el objetivo, usar F-beta con beta=0.5 (favorece precisión)
cat("No se alcanza precisión >= 90%, usando F0.5 score\n")
pr_data$f_beta <- (1 + 0.5^2) * pr_data$precision * pr_data$recall /
(0.5^2 * pr_data$precision + pr_data$recall)
best_idx <- which.max(pr_data$f_beta)
selected_threshold <- pr_data$threshold[best_idx]
selected_precision <- pr_data$precision[best_idx]
selected_recall <- pr_data$recall[best_idx]
cat("Umbral óptimo (F0.5):\n")
cat("   • Threshold:", round(selected_threshold, 4), "\n")
cat("   • Precision (Train):", round(selected_precision, 4), "\n")
cat("   • Recall (Train):", round(selected_recall, 4), "\n")
cat("   • F0.5 (Train):", round(pr_data$f_beta[best_idx], 4), "\n")
}
cat("\nEVALUACIÓN EN VALIDATION CON UMBRAL SELECCIONADO\n")
# Aplicar umbral
y_pred_val_binary <- as.numeric(y_score_val >= selected_threshold)
# Calcular métricas
conf_mat <- confusionMatrix(
factor(y_pred_val_binary, levels = c(0, 1)),
factor(y_val_binary, levels = c(0, 1)),
positive = "1"
)
precision_val <- conf_mat$byClass["Pos Pred Value"]
recall_val <- conf_mat$byClass["Sensitivity"]
f1_val <- conf_mat$byClass["F1"]
cat("Métricas en Validation:\n")
cat("   • Precision:", round(precision_val, 4), "\n")
cat("   • Recall:", round(recall_val, 4), "\n")
cat("   • F1:", round(f1_val, 4), "\n\n")
cat("Matriz de Confusión (Validation):\n")
print(conf_mat$table)
# Specificity y FPR en validation
TN <- as.numeric(conf_mat$table[1,1])
FP <- as.numeric(conf_mat$table[2,1])
FN <- as.numeric(conf_mat$table[1,2])
TP <- as.numeric(conf_mat$table[2,2])
Specificity <- TN / (TN + FP)
FPR <- FP / (TN + FP)
cat("\nMétricas adicionales (Validation) - Persona vs Resto:\n")
cat("=" %>% rep(60) %>% paste0(collapse = ""), "\n")
cat(sprintf("  • Specificity (Especificidad): %.4f\n", Specificity))
cat(sprintf("  • FPR (False Positive Rate): %.4f\n", FPR))
cat("\nInterpretación de Métricas:\n")
cat("-" %>% rep(60) %>% paste0(collapse = ""), "\n")
cat("  • Specificity (TN/(TN+FP)):\n")
cat("    - Mide la capacidad del modelo para identificar correctamente los NO-Persona\n")
cat(sprintf("    - Valor: %.2f%% de los objetos NO-Persona fueron correctamente clasificados\n",
Specificity * 100))
if (Specificity >= 0.95) {
cat("    - Excelente: El modelo tiene muy pocos falsos positivos\n")
} else if (Specificity >= 0.85) {
cat("    - Bueno: El modelo identifica bien la mayoría de NO-Persona\n")
} else {
cat("    - Moderado: Existe un número considerable de falsos positivos\n")
}
cat("\n  • FPR (FP/(TN+FP)):\n")
cat("    - Mide la proporción de falsos positivos entre los negativos reales\n")
cat(sprintf("    - Valor: %.2f%% de los NO-Persona fueron incorrectamente clasificados como Persona\n",
FPR * 100))
if (FPR <= 0.05) {
cat("    - Excelente: Tasa de falsos positivos muy baja\n")
} else if (FPR <= 0.15) {
cat("    - Aceptable: Tasa de falsos positivos razonable\n")
} else {
cat("    - Alta: Muchos NO-Persona clasificados erróneamente como Persona\n")
}
cat("\n  • Relación:\n")
cat("    - FPR + Specificity = 1 (verificación:", round(FPR + Specificity, 4), ")\n")
cat("    - Al priorizar Precision, sacrificamos algo de Recall pero ganamos en Specificity\n")
cat("\nImplicaciones Prácticas:\n")
cat("-" %>% rep(60) %>% paste0(collapse = ""), "\n")
if (precision_val >= 0.85 && Specificity >= 0.90) {
cat("  • Configuración adecuada para aplicaciones donde las falsas alarmas son costosas\n")
cat("  • Baja tasa de falsos positivos (FPR bajo) y alta precisión\n")
} else if (precision_val >= 0.70 && Specificity >= 0.80) {
cat("  • Balance razonable entre detectar personas y evitar falsas alarmas\n")
cat("  • Apropiado para aplicaciones con tolerancia moderada a errores\n")
} else {
cat("  • Considerar ajustar el umbral si los falsos positivos son problemáticos\n")
cat("  • O aumentar el umbral si se requiere mayor precisión y specificity\n")
}
cat("COMPARACIÓN: Training vs Validation\n")
# Tabla comparativa
comparison <- data.frame(
Metrica = c("Precision", "Recall", "F1"),
Training = c(selected_precision, selected_recall,
2 * selected_precision * selected_recall /
(selected_precision + selected_recall)),
Validation = c(precision_val, recall_val, f1_val)
)
comparison$Diferencia <- comparison$Training - comparison$Validation
comparison$Diferencia_Pct <- (comparison$Diferencia / comparison$Training) * 100
print(comparison)
cat("\nINTERPRETACIÓN:\n")
cat("-" %>% rep(70) %>% paste0(collapse = ""), "\n")
# Evaluar diferencias
precision_gap <- abs(comparison$Diferencia_Pct[1])
recall_gap <- abs(comparison$Diferencia_Pct[2])
cat("\n1. PRECISIÓN:\n")
cat("   • Gap:", round(precision_gap, 2), "%\n")
if(precision_gap < 5) {
cat("   • Excelente consistencia (< 5%)\n")
} else if(precision_gap < 10) {
cat("   • Buena consistencia (5-10%)\n")
} else {
cat("   • Discrepancia significativa (> 10%)\n")
}
cat("\n2. RECALL:\n")
cat("   • Gap:", round(recall_gap, 2), "%\n")
if(recall_gap < 5) {
cat("   • Excelente consistencia (< 5%)\n")
} else if(recall_gap < 10) {
cat("   • Buena consistencia (5-10%)\n")
} else {
cat("   • Discrepancia significativa (> 10%)\n")
}
cat("\n3. GENERALIZACIÓN:\n")
avg_gap <- mean(c(precision_gap, recall_gap))
if(avg_gap < 5) {
cat("   • Excelente generalización del modelo\n")
cat("   • El umbral seleccionado es robusto y transferible\n")
} else if(avg_gap < 10) {
cat("   • Buena generalización con ligero ajuste\n")
cat("   • Considerar re-calibración en validation si es necesario\n")
} else {
cat("   • Problemas de generalización detectados\n")
cat("   • Recomendado: Re-calibrar umbral específicamente en validation\n")
}
cat("\n4. COMPROMISO PRECISION-RECALL:\n")
if(precision_val >= 0.85) {
cat("   • Precisión alta lograda (≥85%)\n")
cat("   • Apropiado para aplicaciones donde falsos positivos son costosos\n")
} else {
cat("   • Precisión moderada (<85%)\n")
cat("   • Considerar ajustar umbral si se requiere mayor precisión\n")
}
if(recall_val >= 0.70) {
cat("   • Recall razonable (≥70%)\n")
cat("   • Buen balance entre detectar personas y evitar falsas alarmas\n")
} else {
cat("   • Recall bajo (<70%)\n")
cat("   • Muchas personas no detectadas - evaluar si es aceptable para el caso de uso\n")
}
# Visualización de comparación
comparison_long <- comparison %>%
select(-Diferencia, -Diferencia_Pct) %>%
pivot_longer(cols = c(Training, Validation),
names_to = "Set",
values_to = "Valor")
ggplot(comparison_long, aes(x = Metrica, y = Valor, fill = Set)) +
geom_bar(stat = "identity", position = "dodge", alpha = 0.8) +
geom_text(aes(label = round(Valor, 3)),
position = position_dodge(width = 0.9),
vjust = -0.5, size = 4) +
scale_fill_manual(values = c("Training" = "#4DAF4A", "Validation" = "#377EB8")) +
labs(title = "Persona vs Resto: Comparación Train vs Validation",
subtitle = paste0("Umbral seleccionado: ", round(selected_threshold, 4)),
x = "Métrica",
y = "Valor",
fill = "Conjunto") +
coord_cartesian(ylim = c(0, 1)) +
theme_minimal() +
theme(legend.position = "top",
plot.title = element_text(face = "bold"))
cat("RESUMEN EJECUTIVO - ENTREGABLE 2\n")
cat("1. PREPARACIÓN DE DATOS:\n")
cat("   • Reasignación de clases implementada correctamente\n")
cat("   • División secuencial 200k/200k aplicada\n")
cat("   • Normalización y feature engineering realizados\n\n")
cat("2. ANÁLISIS RCS:\n")
cat("   • Diferencia estadísticamente significativa entre Persona y Vehículo Grande\n")
cat("   • Efecto de magnitud", tolower(efecto), "\n")
cat("   • RCS es una característica discriminativa pero no suficiente por sí sola\n\n")
cat("3. MODELO MULTICLASE:\n")
cat("   • XGBoost con interacciones entrenado exitosamente\n")
cat("   • mAP Training:", round(mAP_train, 3), "\n")
cat("   • mAP Validation:", round(mAP_val, 3), "\n")
cat("   • Gap:", round(gap_percent, 2), "%\n\n")
cat("4. ANÁLISIS ESPACIAL:\n")
cat("   • AP analizado en función de distancia y azimut\n")
cat("   • Tendencias identificadas y explicadas físicamente\n\n")
cat("5. PERSONA VS RESTO:\n")
cat("   • Umbral seleccionado priorizando precisión\n")
cat("   • Precision (Val):", round(precision_val, 3), "\n")
cat("   • Recall (Val):", round(recall_val, 3), "\n")
cat("   • Generalización:", ifelse(avg_gap < 5, "Excelente",
ifelse(avg_gap < 10, "Buena", "Moderada")), "\n")
cat("RECOMENDACIONES\n")
cat("1. MEJORAS DEL MODELO:\n")
cat("   • Explorar ensembles (RF + XGBoost)\n")
cat("   • Implementar calibración de probabilidades (Platt scaling)\n")
cat("   • Considerar modelos específicos por rango de distancia\n\n")
cat("2. FEATURE ENGINEERING:\n")
cat("   • Agregar características temporales si están disponibles\n")
cat("   • Explorar transformaciones no lineales adicionales\n")
cat("   • Considerar PCA para reducción de dimensionalidad\n\n")
cat("3. UMBRALES ADAPTATIVOS:\n")
cat("   • Implementar umbrales diferentes según distancia\n")
cat("   • Ajustar confianza según ángulo de azimut\n")
cat("   • Crear zonas de operación (alta/media/baja confiabilidad)\n\n")
cat("4. VALIDACIÓN ADICIONAL:\n")
cat("   • Implementar validación cruzada k-fold\n")
cat("   • Evaluar en datos de diferentes sensores si están disponibles\n")
cat("   • Realizar análisis de errores por subcategorías\n\n")
cat("5. CONSIDERACIONES DE PRODUCCIÓN:\n")
cat("   • Monitorear drift en distribución de clases\n")
cat("   • Implementar detección de casos de baja confianza\n")
cat("   • Establecer protocolo de actualización del modelo\n")
cat("   • Documentar limitaciones y casos extremos\n")
cat("LIMITACIONES\n")
cat("1. SUPUESTO DE INDEPENDENCIA:\n")
cat("   • Cada detección tratada como independiente\n")
cat("   • En realidad, múltiples detecciones pueden ser del mismo objeto\n")
cat("   • Impacto: Métricas pueden ser optimistas\n\n")
cat("2. CLASES FALTANTES:\n")
cat("   • Clases 4, 6, 9 no presentes en datos\n")
cat("   • Modelo no puede generalizar a estas clases\n\n")
cat("3. DIVISIÓN TEMPORAL:\n")
cat("   • División secuencial puede tener sesgo temporal\n")
cat("   • Asume que primeros 200k y siguientes 200k son comparables\n\n")
cat("4. BALANCE PRECISION-RECALL:\n")
cat("   • Priorización de precisión sacrifica recall\n")
cat("   • Apropiado para evitar falsas alarmas, pero puede perder detecciones\n\n")
cat("5. GENERALIZACIÓN:\n")
cat("   • Modelo entrenado en un sensor/configuración específica\n")
cat("   • Puede no generalizar a diferentes radares o condiciones\n")
cat("INFORMACIÓN DE SESIÓN\n")
sessionInfo()
